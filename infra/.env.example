# PostgreSQL Configuration (Warehouse)
POSTGRES_USER=data_warehouse
POSTGRES_PASSWORD=data_warehouse
POSTGRES_DB=data_warehouse_project
POSTGRES_PORT=5432

# Path to datasets inside the container (read-only mount)
# This is the path the bronze.load_bronze() procedure receives
DATASETS_DIR_CONTAINER=/data/datasets

# Path to datasets on the host (relative to infra/ directory)
# Used by docker-compose.yml to mount the volume
DATASETS_DIR_HOST=../datasets

# =============================================================
# Airflow Configuration (only used with --profile airflow)
# =============================================================

# Airflow Metadata Database (separate from warehouse)
AIRFLOW_METADATA_USER=airflow
AIRFLOW_METADATA_PASSWORD=airflow
AIRFLOW_METADATA_DB=airflow

# Airflow Admin User (for UI login)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow Security Keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# AIRFLOW__CORE__FERNET_KEY=  # leave empty in example; generate for local .env
# AIRFLOW__WEBSERVER__SECRET_KEY=  # leave empty in example; generate for local .env

# Slack Webhook for notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ