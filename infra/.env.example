# PostgreSQL Configuration
POSTGRES_USER=data_warehouse
POSTGRES_PASSWORD=data_warehouse
POSTGRES_DB=data_warehouse_project
POSTGRES_PORT=5432

# Path to datasets inside the container (read-only mount)
# This is the path the bronze.load_bronze() procedure receives
DATASETS_DIR_CONTAINER=/data/datasets

# Path to datasets on the host (relative to infra/ directory)
# Used by docker-compose.yml to mount the volume
DATASETS_DIR_HOST=../datasets