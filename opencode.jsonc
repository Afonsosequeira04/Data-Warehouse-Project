{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      // Default: ask for anything not listed. Later rules override earlier ones.
      "*": "ask",

      // Normal development: allowed
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git ls-remote*": "allow",
      "git rev-parse*": "allow",
      "git remote*": "allow",
      "git merge-base*": "allow",
      "git fetch*": "allow",
      "git pull --ff-only*": "allow",
      "git checkout*": "allow",
      "git switch*": "allow",
      "git branch*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "gh pr create*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr status*": "allow",
      "gh issue*": "allow",
      "gh repo view*": "allow",
      "gh auth status*": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "mkdir *": "allow",
      "mv *": "allow",
      "cp *": "allow",
      "touch *": "allow",
      "echo *": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "ruff*": "allow",
      "terraform fmt*": "allow",
      "terraform validate*": "allow",

      // Ask first
      "terraform apply*": "ask",
      "terraform state*": "ask",
      "terraform import*": "ask",
      "git branch -D*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "rm *": "ask",

      // Denied (these come last so they always win)
      "terraform destroy*": "deny",
      "terraform force-unlock*": "deny",
      "terraform push*": "deny",
      "git push*origin main*": "deny",
      "git push*:main*": "deny",
      "git push*--force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "gh pr merge*": "deny",
      "gh repo delete*": "deny",
      "cat *.env*": "deny",
      "cat *tfstate*": "deny",
      "rm -rf /*": "deny",
      "sudo *": "deny",
      "mkfs*": "deny",
      "dd if=*": "deny",
      "chmod 777*": "deny"
    },
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      "README.md": "ask",
      "docs/NOTION_PROJECT_PLAN.md": "ask",
      "infra/terraform/**": "ask",
      ".github/workflows/**": "ask",
      ".env*": "deny",
      "*.tfvars": "deny",
      "*.tfstate*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*secret*": "deny",
      "*credential*": "deny",
      "profiles.yml": "deny",
      "secrets.yml": "deny"
    },
    "read": {
      "*": "allow",
      ".env*": "deny",
      "*.tfvars": "deny",
      "*.tfstate*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    }
  }
}
