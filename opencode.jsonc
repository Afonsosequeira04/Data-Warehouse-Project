{
  "$schema": "https://opencode.ai/config.json",
  "name": "cloud-data-platform",
  "description": "OpenCode configuration for Cloud Data Platform repository",
  "permission": [
    {
      "tool": "bash",
      "deny": [
        "terraform apply*",
        "terraform destroy*",
        "terraform import*",
        "terraform state*",
        "terraform push*",
        "terraform force-unlock*",
        "git push*",
        "git merge*",
        "git rebase*",
        "git reset --hard*",
        "gh pr merge*",
        "gh repo delete*",
        "aws * create*",
        "aws * delete*",
        "aws * terminate*",
        "aws * put*",
        "aws * update*",
        "aws * attach*",
        "aws * modify*",
        "databricks * create*",
        "databricks * delete*",
        "databricks * update*",
        "fivetran * create*",
        "fivetran * delete*",
        "fivetran * update*",
        "rm -rf /",
        "rm -rf /*",
        "dd if=* of=*",
        "mkfs*",
        "fdisk*",
        "shred*",
        "> /dev/sd*",
        "chmod 777*",
        "chown -R*",
        "sudo *",
        "su -",
        "passwd*"
      ],
      "ask": [
        "terraform init*",
        "terraform plan*",
        "terraform fmt*",
        "terraform validate*",
        "terraform output*",
        "terraform show*",
        "git commit*",
        "git add*",
        "git checkout*",
        "git branch*",
        "git tag*",
        "gh pr create*",
        "gh workflow run*",
        "aws * get*",
        "aws * describe*",
        "aws * list*",
        "aws * read*",
        "databricks * get*",
        "databricks * list*",
        "fivetran * get*",
        "fivetran * list*",
        "python -m pytest*",
        "dbt run*",
        "dbt build*",
        "dbt test*",
        "dbt snapshot*",
        "pip install*",
        "poetry install*",
        "npm install*",
        "make*",
        "docker*"
      ],
      "allow": [
        "git status",
        "git diff*",
        "git log*",
        "git show*",
        "git ls-files*",
        "git ls-tree*",
        "cat*",
        "ls*",
        "find*",
        "grep*",
        "rg*",
        "head*",
        "tail*",
        "less*",
        "more*",
        "wc*",
        "stat*",
        "file*",
        "python -m compileall*",
        "python -m py_compile*",
        "python -c*",
        "terraform fmt -check*",
        "terraform validate*",
        "terraform plan -out=*",
        "dbt parse*",
        "dbt deps*",
        "dbt ls*",
        "dbt docs generate*",
        "pytest*",
        "ruff*",
        "black --check*",
        "mypy*",
        "gh pr view*",
        "gh issue*",
        "gh repo view*",
        "gh api*",
        "aws sts get-caller-identity*",
        "aws s3 ls*",
        "databricks fs ls*",
        "databricks sql*"
      ]
    },
    {
      "tool": "edit",
      "deny": [
        ".env*",
        "*.tfvars",
        "*.tfstate*",
        "*.pem",
        "*.key",
        "*secret*",
        "*credential*",
        "profiles.yml",
        "secrets.yml"
      ],
      "ask": [
        "AGENTS.md",
        "README.md",
        "docs/NOTION_PROJECT_PLAN.md",
        "infra/terraform/**",
        "dbt_project/profiles.yml*",
        ".github/workflows/**"
      ],
      "allow": [
        "**/*.md",
        "**/*.py",
        "**/*.sql",
        "**/*.yml",
        "**/*.yaml",
        "**/*.json",
        "**/*.txt",
        "**/*.toml",
        "**/*.cfg",
        "**/*.ini",
        ".gitignore",
        "opencode.jsonc"
      ]
    },
    {
      "tool": "write",
      "deny": [
        ".env*",
        "*.tfvars",
        "*.tfstate*",
        "*.pem",
        "*.key",
        "*secret*",
        "*credential*",
        "profiles.yml",
        "secrets.yml"
      ],
      "ask": [
        "AGENTS.md",
        "README.md",
        "docs/NOTION_PROJECT_PLAN.md",
        "infra/terraform/**",
        "dbt_project/profiles.yml*",
        ".github/workflows/**",
        "docs/decisions/ADR-*.md"
      ],
      "allow": [
        "**/*.md",
        "**/*.py",
        "**/*.sql",
        "**/*.yml",
        "**/*.yaml",
        "**/*.json",
        "**/*.txt",
        "**/*.toml",
        "**/*.cfg",
        "**/*.ini",
        ".gitignore",
        "opencode.jsonc",
        "docs/decisions/README.md",
        "docs/decisions/ADR-template.md",
        "docs/data-sources.md",
        "docs/business-questions.md"
      ]
    }
  ],
  "environment": {
    "variables": {
      "PYTHONPATH": ".",
      "DBT_PROFILES_DIR": "dbt_project"
    }
  }
}